# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Database (PostgreSQL 15+ with the pgvector extension) ---
DATABASE_URL=postgresql+psycopg://localhost:5432/enterprise_intelligence

# --- AI providers ---
# auto = use Gemini when GEMINI_API_KEY is set, otherwise the local mock providers
EMBEDDING_PROVIDER=auto
LLM_PROVIDER=auto

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# must stay 768 unless you change the vector(768) column via a migration and re-embed
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
GEMINI_EMBEDDING_BATCH_SIZE=100
GEMINI_TIMEOUT_SECONDS=60
GEMINI_LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=60

# --- Ingestion ---
STORAGE_DIR=storage/uploads
MAX_UPLOAD_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=20

# --- API ---
CORS_ORIGINS=http://localhost:5173
